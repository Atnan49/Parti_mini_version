<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive files (Security Hardening)
    # ponytail: protect credential theft on shared hosting environments
    RedirectMatch 403 /\.(env|git|htaccess|config|json|lock|xml|yml|yaml)$
    RedirectMatch 403 /(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/

    # 2. Rewrite all public requests into Laravel's public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
